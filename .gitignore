# Build products of the in-tree JNetHack build (see test/build.sh).
# This tree builds in place, so generated files land next to their sources.

# Makefiles copied out of sys/unix by test/build.sh
/Makefile
/dat/Makefile
/doc/Makefile
/src/Makefile
/util/Makefile

*.o
/src/jnethack
/src/jnethack.tty
/src/jnethack.sdl
/src/Sys*
/util/makedefs
/util/lev_comp
/util/dgn_comp
/util/recover
/util/dlb

# generated by makedefs
/include/date.h
/include/onames.h
/include/pm.h
/include/vis_tab.h
/include/jdata.h
/src/monstr.c
/src/vis_tab.c

# generated by japanese/mkjis0208.py -- checked in, listed here only as a
# reminder that it is generated; see japanese/mkjis0208.py
#/include/jis0208.h

# pre-generated parsers copied in from sys/share
/util/lev_lex.c
/util/lev_yacc.c
/util/dgn_lex.c
/util/dgn_yacc.c
/include/lev_comp.h
/include/dgn_comp.h

# compiled data files
/dat/*.lev
/dat/data
/dat/dungeon
/dat/dungeon.pdf
/dat/options
/dat/joracles
/dat/jrumors
/dat/quest.dat
/dat/nhdat
/dat/spec_levs
/dat/quest_levs

.idea/
