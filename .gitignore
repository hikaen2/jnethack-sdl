# Build products of the in-tree JNetHack build (see test/build.sh).
# This tree builds in place, so generated files land next to their sources.

# Makefiles copied out of sys/unix by test/build.sh
/Makefile
/dat/Makefile
/doc/Makefile
/src/Makefile
/util/Makefile

*.o
# make timestamp stamps (sys/unix/Makefile.src CONFIG_H / HACK_H)
/src/config.h-t
/src/hack.h-t
/src/jnethack
/src/jnethack.tty
/src/jnethack.sdl
/src/JNetHack.exe
/src/Sys*
/util/makedefs
/util/lev_comp
/util/dgn_comp
/util/recover
/util/dlb
/util/*.exe

# generated by makedefs
/include/date.h
/include/onames.h
/include/pm.h
/include/vis_tab.h
/include/jdata.h
/src/monstr.c
/src/vis_tab.c

# generated by japanese/mkjis0208.py -- checked in, listed here only as a
# reminder that it is generated; see japanese/mkjis0208.py
#/include/jis0208.h

# pre-generated parsers copied in from sys/share
/util/lev_lex.c
/util/lev_yacc.c
/util/dgn_lex.c
/util/dgn_yacc.c
/include/lev_comp.h
/include/dgn_comp.h

# compiled data files
/dat/*.lev
/dat/data
/dat/dungeon
/dat/dungeon.pdf
/dat/options
# what include/ntconf.h calls the same file (OPTIONS_USED); the Windows
# phase of test/build.sh writes it into dat/ through makedefs' fixed
# "../dat/%s" template
/dat/ttyoptions
/dat/joracles
/dat/jrumors
/dat/quest.dat
/dat/nhdat
/dat/spec_levs
/dat/quest_levs

# the same data rebuilt for the Windows binary (test/build.sh stages it)
/datwin/

.idea/

# Windows distribution zip (see sys/winnt/mkdist.sh)
/dist/
