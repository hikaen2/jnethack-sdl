# Build products of the in-tree NetHack build (see test/build.sh).
# The stock 3.2.3 tree builds in place, so generated files land next to
# their sources.

# Makefiles copied out of sys/unix by test/build.sh
/Makefile
/dat/Makefile
/doc/Makefile
/src/Makefile
/util/Makefile

*.o
/src/nethack
/src/nethack.tty
/src/nethack.sdl
/src/Sys*
/util/makedefs
/util/lev_comp
/util/dgn_comp
/util/recover
/util/dlb

# generated by makedefs
/include/date.h
/include/onames.h
/include/pm.h
/include/vis_tab.h
/src/monstr.c
/src/vis_tab.c

# pre-generated parsers copied in from sys/share
/util/lev_lex.c
/util/lev_yacc.c
/util/dgn_lex.c
/util/dgn_yacc.c
/include/lev_comp.h
/include/dgn_comp.h

# compiled data files
/dat/*.lev
/dat/data
/dat/dungeon
/dat/dungeon.pdf
/dat/options
/dat/oracles
/dat/quest.dat
/dat/rumors
/dat/nhdat
/dat/spec_levs
/dat/quest_levs

.idea/
